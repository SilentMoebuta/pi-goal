{
	"name": "pi-goal",
	"version": "1.0.0",
	"type": "module",
	"description": "Persistent autonomous goals for Pi Agent — LLM judge evaluation, criteria tracking, no-progress detection, and token budgets. Inspired by Claude Code /goal.",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"pi": {
		"extensions": [
			"./extensions"
		],
		"skills": [
			"./skills"
		],
		"prompts": [
			"./prompts"
		]
	},
	"scripts": {
		"test": "tsx --test \"__tests__/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"goal-spec": "tsx scripts/goal-spec-v3.ts"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^0.84.1",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"@earendil-works/pi-tui": "^0.84.1"
	},
	"devDependencies": {
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	}
}
