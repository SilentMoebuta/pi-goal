{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentmoebuta.github.io/pi-goal/schemas/benchmark-fixture-v1.schema.json",
  "title": "PI Benchmark Fixture V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "kind", "objective", "input", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["coding", "research", "document", "business"] },
    "objective": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "expected": { "type": "object", "additionalProperties": false, "required": ["criteria"], "properties": { "criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "requiredArtifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "referenceOutput": { "type": "string" } } }
  }
}
