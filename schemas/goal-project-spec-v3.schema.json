{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentmoebuta.github.io/pi-goal/schemas/goal-project-spec-v3.schema.json",
  "title": "PI Goal Project Spec V3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "objective", "criteria"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "objective": { "type": "string", "minLength": 1 },
    "original": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "level"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "level": { "enum": ["blocking", "advisory"] }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "claims": { "type": "array", "items": { "type": "object" } },
    "taskKind": { "enum": ["general", "coding", "research", "document", "business", "pm", "review"] },
    "profile": { "type": "string", "minLength": 1 },
    "inputs": { "$ref": "#/$defs/artifacts" },
    "outputs": { "$ref": "#/$defs/artifacts" },
    "instructions": { "type": "string", "minLength": 1 },
    "execution": { "type": "object", "required": ["topology"], "properties": { "topology": { "enum": ["direct", "specialist", "team"] } }, "additionalProperties": true },
    "evidence": { "type": "object" },
    "review": { "type": "object" },
    "verification": { "type": "object" },
    "budget": { "type": "object" },
    "completion": { "type": "object", "additionalProperties": false, "properties": { "maxAutoTurns": { "type": "integer", "minimum": 1 } } }
  },
  "$defs": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "description"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
