{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentmoebuta.github.io/pi-goal/schemas/evaluation-v1.schema.json",
  "title": "PI Deterministic Evaluation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evaluator", "fixtureId", "decision", "score", "checks", "evaluatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evaluator": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "version"], "properties": { "kind": { "const": "deterministic" }, "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "fixtureId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["accept", "revise", "blocked"] },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "checks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "status", "summary"], "properties": { "id": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed"] }, "summary": { "type": "string", "minLength": 1 }, "details": { "type": "object" } } } },
    "evaluatedAt": { "type": "number", "minimum": 0 }
  }
}
